# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External APIs
SERPAPI_KEY=

# Travelpayouts (Aviasales): fuente principal de vuelos.
# TOKEN personal: https://www.travelpayouts.com/developers/api
TRAVELPAYOUTS_TOKEN=
# Tu ID de partner (marker). Se añade a los enlaces de reserva de Aviasales
# para atribuirte la venta. Lo encuentras en la barra/URL de tu panel.
TRAVELPAYOUTS_MARKER=
GEMINI_API_KEY=

# StayingAPI: precios reales de alojamientos (Booking, Google Hotels). Gratis.
# Obtener clave: https://stayingapi.com/signup  (stay_test_ usa fixtures de prueba)
STAYINGAPI_KEY=

# Stay22: precios reales de alojamientos (Booking, VRBO, Expedia, Hotels.com).
# Gratis. Obtener clave: https://hub.stay22.com (API key → header X-API-KEY).
# Se usa como alternativa cuando Stay/Google fallan.
STAY22_API_KEY=

# BlaBlaCar (precios reales de coche compartido, API oficial)
# Solicitar clave: https://support.blablacar.com/hc/es (Formulario "Developer BlaBlaCar API")
BLABLACAR_API_KEY=

# Geocodificación (opcional): Geoapify 3000 req/día gratis; sin clave se usa Nominatim
GEOAPIFY_API_KEY=

# Notificaciones push (Web Push / PWA)
# Generar par de claves VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com